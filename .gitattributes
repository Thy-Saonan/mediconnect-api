# Auto-detect text files and normalize line endings
* text=auto

# Force LF for all common source files
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf

# Force shell scripts to LF
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF
mvnw.cmd text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf